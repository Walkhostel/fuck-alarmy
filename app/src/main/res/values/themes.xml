<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Дефолтный Material UI, перекрашенный: главный цвет чёрный, акцент красный. -->
    <style name="Theme.MathAlarm" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/app_black</item>
        <item name="colorPrimaryDark">@color/app_black</item>
        <item name="colorAccent">@color/app_red</item>
        <item name="colorControlActivated">@color/app_red</item>
        <item name="colorControlHighlight">@color/app_red</item>

        <item name="android:windowBackground">@color/app_black</item>
        <item name="android:statusBarColor">@color/app_black</item>
        <item name="android:navigationBarColor">@color/app_black</item>

        <item name="android:textColorPrimary">@color/app_white</item>
        <item name="android:textColorSecondary">@color/app_white</item>
        <item name="android:textColorHint">@color/app_gray_hint</item>
        <item name="android:editTextColor">@color/app_white</item>
    </style>
</resources>
